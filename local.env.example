# Per-machine settings for voice-input-mac.
#
# Copy to `local.env` (untracked, see .gitignore) and edit on THAT machine.
# Never copy local.env between machines: M2 and M4 run different models on
# purpose (M4 is a 64GB studio that can afford bigger ones, M2 is a 16GB mini),
# and overwriting one machine's choice with the other's is a silent behaviour
# change. Only the defaults in transcribe.py are shared.

# Speech recognition model (mlx-whisper / HuggingFace repo id)
# VOICE_STT_REPO=mlx-community/whisper-large-v3-turbo

# Polish model (mlx-lm / HuggingFace repo id)
# VOICE_POLISH_REPO=mlx-community/Qwen2.5-7B-Instruct-4bit

# Default input device for recording: index or name substring.
# Unset = the system default input, which is the right choice most of the time
# (M2: SOUNDPEATS POP Clip / BOYA mini 2, M4: MixPre-6 II).
# VOICE_INPUT_DEVICE=SOUNDPEATS
