# Per-machine settings for voice-input-mac.
#
# Copy to `local.env` (untracked, see .gitignore) and edit on THAT machine.
# Never copy local.env between machines: M2 and M4 run different models on
# purpose (M4 is a 64GB studio that can afford bigger ones, M2 is a 16GB mini),
# and overwriting one machine's choice with the other's is a silent behaviour
# change. Only the defaults in transcribe.py are shared.

# Speech recognition model (mlx-whisper / HuggingFace repo id)
# VOICE_STT_REPO=mlx-community/whisper-large-v3-turbo

# Rewrite backend: cloud (Vertex AI), rules (deterministic punctuation), or off.
# VOICE_REWRITE_BACKEND=cloud

# Cloud rewrite settings.
# VOICE_CLOUD_REWRITE_MODEL=gemini-3.8-flash
# VOICE_CLOUD_REWRITE_LOCATION=global
# VOICE_CLOUD_REWRITE_PROJECT=
#   Timeout only bounds the BACKGROUND refinement now (the paste never waits for
#   the cloud), so keep it just under the app's wait so nothing is wasted.
# VOICE_CLOUD_REWRITE_TIMEOUT=8
# VOICE_CLOUD_REWRITE_MAX_OUTPUT_TOKENS=1024
# VOICE_CLOUD_REWRITE_MAX_TERMS=60
# VOICE_REWRITE_TERMS_FILE=./rewrite_terms.json

# Thinking budget for the rewrite model. Gemini 3.8 Flash spends 300-980 tokens
# "thinking", which both delays the call and can eat the whole output budget
# (finish=MAX_TOKENS -> truncated half-sentence). 0 = ask for no thinking
# (the model does not always obey); `none` = send no thinkingConfig at all.
# VOICE_CLOUD_THINKING_BUDGET=0

# How long the background refinement may take before the app keeps the
# rule-based text it already pasted. Must stay BELOW the app's wait (10s).
# VOICE_REFINE_WAIT=8

# Manual-edit learning runs locally after insertion. Set to 0 to disable.
# VOICE_LEARN_EDITS=1

# Default input device for recording: index or name substring.
# Unset = the system default input, which is the right choice most of the time
# (M2: SOUNDPEATS POP Clip / BOYA mini 2, M4: MixPre-6 II).
# VOICE_INPUT_DEVICE=SOUNDPEATS
